{
  "plugins": ["eslint", "typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Complexity gate — mirrors the Python ruff config (C901 + PLR0911/0912/0913/0915).
    "complexity": ["error", 10],
    "max-params": ["error", 9],
    "max-lines-per-function": ["error", { "max": 100, "skipBlankLines": true, "skipComments": true }],
    "no-useless-return": "error",
    "no-unused-vars": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "**/*.d.ts", "scripts/**"]
}
